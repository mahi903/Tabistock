rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // 管理者判定：admins/{uid} ドキュメントが存在すれば管理者
    // （あなたのUIDを Firebase コンソールで admins コレクションに手動追加する）
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- ユーザープロフィール（非公開・email等を含む） ----
    match /users/{uid} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if request.auth.uid == uid || isAdmin();
      allow delete: if isAdmin();

      // 保存した投稿（ブックマーク）。本人だけが読み書きできる。
      match /saves/{articleId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // プッシュ通知トークン。本人だけが登録・削除できる。
      // 送信側（サーバー/firebase-admin）はルールを介さず読めるため read は本人のみで十分。
      match /pushTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // フォロー中リスト（自分がフォローしている相手）。数は誰でも閲覧、編集は本人のみ。
      match /following/{targetUid} {
        allow read:  if true;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }

      // フォロワーリスト（自分をフォローしている人）。数は誰でも閲覧。
      // 追加・削除は「フォローする本人」が自分のUIDを出し入れする。
      match /followers/{followerUid} {
        allow read:  if true;
        allow write: if isSignedIn() && request.auth.uid == followerUid;
      }

      // 通知。受信者（uid本人）だけが閲覧・既読更新・削除できる。
      // 作成は「行動した人（fromUid＝自分）」が相手の通知箱に1件入れる。
      match /notifications/{nid} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn()
                      && request.resource.data.fromUid == request.auth.uid
                      && request.resource.data.type is string;
      }
    }

    // ---- 公開プロフィール（名前・アイコン・自己紹介・SNSのみ／誰でも閲覧可） ----
    // 記事ページの執筆者カードが未ログイン訪問者にも見せるために使う。
    match /publicProfiles/{uid} {
      allow read:  if true;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- 管理者リスト（コンソールからのみ編集） ----
    // UID のみを保持（機密情報なし）。管理者バッジ表示のため公開読み取り可。
    match /admins/{uid} {
      allow read:  if true;
      allow write: if false;
    }

    // ---- 記事 ----
    // 共同投稿（Instagram のコラボ投稿と同じ仕組み）：
    //   coAuthorInvites … 招待中の uid（元の投稿者が追加・取り消し）
    //   coAuthorIds     … 承認済みの共同投稿者 uid（本人が承認して入る。投稿者欄に並び、編集もできる）
    match /articles/{articleId} {

      // 著者・共同投稿者が許可される status 遷移：
      //   - 同じ status の維持（本文編集など）
      //   - draft / rejected → pending（申請・再申請）
      //   - published → hidden（自分で非表示にする）
      //   - hidden → published（再公開。一度承認済みなので承認不要で戻せる）
      function okStatusChange() {
        let a = resource.data.status;
        let b = request.resource.data.status;
        return b == a
            || ((a == 'draft' || a == 'rejected') && b == 'pending')
            || (a == 'published' && b == 'hidden')
            || (a == 'hidden' && b == 'published');
      }
      function coIds(d)     { return d.get('coAuthorIds', []); }
      function invites(d)   { return d.get('coAuthorInvites', []); }
      function onlyChanged(keys) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
      }

      // 公開記事は誰でも閲覧可。下書き/承認待ちは本人・共同投稿者・招待された人・管理者のみ。
      // （一覧クエリでも評価できるよう、配列は get() を使わず直接参照する）
      allow read: if resource.data.status == 'published'
                  || (isSignedIn() && resource.data.authorId == request.auth.uid)
                  || (isSignedIn() && request.auth.uid in resource.data.coAuthorIds)
                  || (isSignedIn() && request.auth.uid in resource.data.coAuthorInvites)
                  || isAdmin();

      // 作成：ログイン必須・自分を著者にする・status は 'pending'（申請）か 'draft'（下書き）。
      //       共同投稿者は承認制なので、作成時点では招待（最大5人）だけ入れられる。
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && (request.resource.data.status == 'pending'
                        || request.resource.data.status == 'draft')
                    && coIds(request.resource.data).size() == 0
                    && invites(request.resource.data).size() <= 5;

      // 更新：管理者は何でも可（承認＝status変更を含む）。最初の公開（pending）は管理者承認が必要。
      allow update: if isAdmin()
                    // 元の投稿者：本文編集・招待の追加/取り消し。共同投稿者は「外す」だけ可
                    //（勝手に追加はできない＝必ず招待→本人の承認を通る）
                    || (isSignedIn()
                        && resource.data.authorId == request.auth.uid
                        && request.resource.data.authorId == request.auth.uid
                        && coIds(request.resource.data).toSet().difference(coIds(resource.data).toSet()).size() == 0
                        && invites(request.resource.data).size() <= 5
                        && okStatusChange())
                    // 元の投稿者：承認済みの共同投稿者に投稿者を譲る（自分は共同投稿者として残る）
                    || (isSignedIn()
                        && resource.data.authorId == request.auth.uid
                        && request.resource.data.authorId in coIds(resource.data)
                        && onlyChanged(['authorId', 'authorNickname', 'coAuthorIds'])
                        && coIds(request.resource.data).toSet()
                           == coIds(resource.data).toSet()
                                .difference([request.resource.data.authorId].toSet())
                                .union([request.auth.uid].toSet()))
                    // 共同投稿者：本文編集（著者・共同投稿者・招待は変えられない）
                    || (isSignedIn()
                        && request.auth.uid in coIds(resource.data)
                        && request.resource.data.authorId == resource.data.authorId
                        && coIds(request.resource.data) == coIds(resource.data)
                        && invites(request.resource.data) == invites(resource.data)
                        && okStatusChange())
                    // 共同投稿者：自分だけ抜ける
                    || (isSignedIn()
                        && request.auth.uid in coIds(resource.data)
                        && onlyChanged(['coAuthorIds'])
                        && coIds(request.resource.data).toSet()
                           == coIds(resource.data).toSet().difference([request.auth.uid].toSet()))
                    // 招待された人：承認（招待から自分を外し、共同投稿者に自分を足す）または辞退（外すだけ）
                    || (isSignedIn()
                        && request.auth.uid in invites(resource.data)
                        && onlyChanged(['coAuthorIds', 'coAuthorInvites'])
                        && invites(request.resource.data).toSet()
                           == invites(resource.data).toSet().difference([request.auth.uid].toSet())
                        && (coIds(request.resource.data).toSet()
                              == coIds(resource.data).toSet().union([request.auth.uid].toSet())
                            || coIds(request.resource.data).toSet() == coIds(resource.data).toSet()));

      // 削除：管理者、または元の投稿者（共同投稿者は「抜ける」だけ）
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.authorId == request.auth.uid);

      // いいね： articles/{id}/likes/{uid}。数は誰でも閲覧、付け外しは本人のみ。
      match /likes/{likeUid} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == likeUid;
      }

      // コメント： articles/{id}/comments/{commentId}。誰でも閲覧。
      // 投稿はログインユーザー（自分を著者にする・本文1〜1000文字）。
      // 返信は parentId に親コメントIDを持つ（フィールドは任意・型のみ緩く許容）。
      // 削除は管理者またはコメント本人。編集は不可。
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;
        allow delete: if isAdmin()
                      || (isSignedIn() && resource.data.authorId == request.auth.uid);

        // コメントのいいね： articles/{id}/comments/{commentId}/likes/{uid}。
        // 数は誰でも閲覧、付け外しは本人のみ。
        match /likes/{likeUid} {
          allow read: if true;
          allow create, delete: if isSignedIn() && request.auth.uid == likeUid;
        }
      }
    }

    // ---- DM（1対1メッセージ） ----
    // conversations/{convId}：convId は参加者2人のUIDを昇順連結（uidA__uidB）。
    // 参加者本人だけが読み書き可。誰にでも送れる（フォロー不問）が、
    // 自分を participants に含む2人だけの会話に限る。
    match /conversations/{convId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      // 一覧取得は participants array-contains 自分 のクエリ前提。
      allow read: if isParticipant();
      // 作成：自分を含む2人だけの会話。
      allow create: if isSignedIn()
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants;
      // 更新：参加者本人（lastMessage や unread の更新）。
      allow update: if isParticipant();

      // メッセージ：参加者だけ閲覧・送信。送信者＝自分、本文1〜2000文字。編集・削除は不可。
      match /messages/{msgId} {
        function inConv() {
          return isSignedIn()
            && request.auth.uid in
               get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        }
        allow read: if inConv();
        allow create: if inConv()
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
      }
    }
  }
}
