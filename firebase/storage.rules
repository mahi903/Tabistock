rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // ユーザーアイコン： avatars/{uid}/{fileName}
    match /avatars/{uid}/{fileName} {
      // アイコンは公開（サイト内で表示するため）
      allow read: if true;

      // アップロードは本人のみ。5MB以下・画像形式に限定。
      allow write: if isSignedIn()
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // 削除は本人のみ
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // 記事用の画像： articles/{articleId}/{fileName}
    match /articles/{articleId}/{fileName} {
      // 画像は公開（サイト訪問者が見られる必要があるため）
      allow read: if true;

      // 新しいアップロードだけ許可（ログイン必須・5MB以下・画像のみ）。
      // ファイル名は毎回ユニークなので、既存の写真の上書き（update）は不要＝禁止。
      allow create: if isSignedIn()
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');

      // 削除・上書きはサイトからは不可（他人の記事の写真を消せないように）。
      // 整理が必要なときは管理者が Firebase コンソールから行う。
      allow update, delete: if false;
    }
  }
}
