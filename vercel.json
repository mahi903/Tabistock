{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tabistock.vercel.app"
        }
      ],
      "destination": "https://tabistock.jp/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/ask.js": {
      "maxDuration": 60
    },
    "api/deleteAccount.js": {
      "maxDuration": 60
    },
    "api/tripPlan.js": {
      "maxDuration": 60
    }
  }
}
